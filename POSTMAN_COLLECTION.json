    {
      "name": "Admin - Connectors CRUD",
      "item": [
        {
          "name": "List All Connectors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/connectors",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "connectors"]
            }
          }
        },
        {
          "name": "Create Connector",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Connector\",\n  \"description\": \"A sample connector\",\n  \"provider\": \"anthropic\",\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"system_prompt\": \"You are a helpful assistant.\",\n  \"input_schema\": [\n    {\n      \"name\": \"text\",\n      \"type\": \"text\",\n      \"required\": true,\n      \"description\": \"Input text\"\n    }\n  ],\n  \"output_schema\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"result\": { \"type\": \"string\" }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/connectors",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "connectors"]
            }
          }
        },
        {
          "name": "Get Connector by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/connectors/{{connector_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "connectors", "{{connector_id}}"]
            }
          }
        },
        {
          "name": "Update Connector",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/connectors/{{connector_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "connectors", "{{connector_id}}"]
            }
          }
        },
        {
          "name": "Disable Connector",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/connectors/{{connector_id}}/disable",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "connectors", "{{connector_id}}", "disable"]
            }
          }
        },
